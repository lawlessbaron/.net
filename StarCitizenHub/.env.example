# Copy to your Railway service variables (or a local .env you load yourself).
# Accounts are optional; without DATABASE_URL the site runs with browser-only saving.
PORT=8080
DATABASE_URL=${{Postgres.DATABASE_URL}}
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Your public address, used for the Discord redirect: <PUBLIC_URL>/auth/discord/callback
PUBLIC_URL=https://your-app.up.railway.app
ADMIN_DISCORD_IDS=
